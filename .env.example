# Copy this file to .env. .env is gitignored — never commit it.
#
# PawPal+ runs against either of two model backends. The RAG pipeline,
# guardrails and scheduler are identical for both; only the model call differs.
#
# ---------------------------------------------------------------------------
# OPTION A — FREE, runs locally, no account, no key, works offline
# ---------------------------------------------------------------------------
# Install once:   brew install ollama
# Start it:       ollama serve
# Get the model:  ollama pull llama3.2:3b
#
PAWPAL_PROVIDER=ollama
PAWPAL_MODEL=llama3.2:3b

# ---------------------------------------------------------------------------
# OPTION B — Anthropic API (paid, faster, higher quality)
# ---------------------------------------------------------------------------
# Comment out the two lines above, uncomment these, and add a real key from
# https://console.anthropic.com/settings/keys
#
# PAWPAL_PROVIDER=anthropic
# PAWPAL_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-your-real-key-here

# If PAWPAL_PROVIDER is unset, the app uses Anthropic when a valid-looking
# ANTHROPIC_API_KEY is present, and falls back to Ollama otherwise.
