# Copy this file to .env and fill in your key. .env is gitignored — never commit it.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
# claude-sonnet-5 or claude-haiku-4-5 are cheaper and work fine for this app.
# PAWPAL_MODEL=claude-opus-5
