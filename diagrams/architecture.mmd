%% System Architecture — PawPal+ (Applied AI System Project)
%% AI feature: Retrieval-Augmented Generation (RAG)
%% Preview: https://mermaid.live  (paste this file's contents)
%%
%% Data flows top to bottom: INPUT -> RETRIEVER -> GENERATOR/AGENT ->
%% EVALUATOR -> HUMAN REVIEW -> SCHEDULER -> OUTPUT.
%%
%% AI results are checked in THREE distinct ways, colour-coded below:
%%   green   EVALUATOR   automated, every run   — _validate() guardrails +
%%                        a self-correction retry when the model under-delivers
%%   amber   HUMAN       every run               — owner ticks/unticks AI
%%                        suggestions, and can edit or remove ANY task, any time
%%   blue    TESTER      dev-time, on demand      — pytest, 141 tests, offline

flowchart TD

    Owner(["Pet owner"])

    %% ---------------- INPUT ----------------
    subgraph INPUT["INPUT — Streamlit UI · app.py"]
        Profile["Pet profile<br/>species · breed · age"]
        Budget["Time budget + availability window<br/>available_minutes, day_start..day_end"]
        Manual["Manual task control<br/>add · edit · 🗑️ remove — any task, any time"]
    end

    %% ---------------- RETRIEVER ----------------
    subgraph RETRIEVER["RETRIEVER — retriever.py · deterministic, offline"]
        KB[("knowledge/<br/>14 markdown care-guidance files")]
        Query["build_query()<br/>species x4 · breed x2 · life stage"]
        Search["TF-IDF KnowledgeBase.search()"]
        Chunks["Top-4 sources<br/>each with a citable id"]
    end

    %% ---------------- GENERATOR / AGENT ----------------
    subgraph GENERATOR["GENERATOR / AGENT — pawpal_ai.py"]
        Prompt["Prompt = pet + budget/window<br/>+ retrieved sources ONLY"]
        Backend{"PAWPAL_PROVIDER<br/>which backend?"}
        Ollama["Ollama<br/>local model · free"]
        Claude["Anthropic API<br/>claude-opus-5 · paid"]
        Draft["Draft tasks<br/>each cites a source_id + time + rationale"]
    end

    %% ---------------- EVALUATOR ----------------
    subgraph EVALUATOR["EVALUATOR — _validate() · automated check of AI output"]
        Grounded{"Was the cited source_id<br/>actually retrieved?"}
        Rules{"duration 1-240 · known priority/frequency<br/>no duplicates · max 8 tasks"}
        Bad["Rejected and logged<br/>reason shown in the UI"]
        Enough{"3+ tasks survived?"}
        Retry["build_topup_prompt()<br/>ask for more, once — lists what's already covered"]
    end

    %% ---------------- HUMAN REVIEW ----------------
    subgraph HUMANCHECK["HUMAN REVIEW — the owner, every run"]
        TickBox["Tick / untick each suggested task"]
    end

    TaskList[("pet.tasks<br/>the shared task list")]

    %% ---------------- SCHEDULER ----------------
    subgraph SCHEDULER["SCHEDULER — pawpal_system.py · deterministic, no AI"]
        Pick["Phase 1: rank by priority,<br/>fit the minute budget"]
        Place["Phase 2: place by time,<br/>inside day_start .. day_end"]
    end

    %% ---------------- OUTPUT ----------------
    subgraph OUTPUT["OUTPUT"]
        Plan["DailyPlan<br/>scheduled · skipped · reason for each"]
    end

    %% ---------------- OBSERVABILITY ----------------
    PLog[("pawpal.log<br/>retrieval scores · accept/reject · tokens")]

    %% ---------------- TESTER ----------------
    subgraph TESTER["TESTER — pytest · 141 tests · fully offline"]
        Fake["Fake API client +<br/>mocked Ollama HTTP layer"]
        Coverage["retrieval quality · guardrails ·<br/>time inference · top-up loop · scheduler window"]
        Mutation["Mutation check:<br/>disabling the top-up fix fails 5 tests"]
    end

    %% ================ MAIN DATA FLOW ================
    Owner --> Profile
    Owner --> Budget
    Owner --> Manual

    Profile --> Query
    Budget --> Query
    KB --> Search
    Query --> Search
    Search --> Chunks

    Chunks --> Prompt
    Profile --> Prompt
    Budget --> Prompt
    Prompt --> Backend
    Backend -->|ollama| Ollama
    Backend -->|anthropic| Claude
    Ollama --> Draft
    Claude --> Draft

    Draft --> Grounded
    Chunks -.->|allowed source ids| Grounded
    Grounded -->|no| Bad
    Grounded -->|yes| Rules
    Rules -->|fails a rule| Bad
    Rules -->|passes| Enough
    Enough -->|no, once| Retry
    Retry -.->|amended prompt| Prompt
    Enough -->|yes| TickBox

    TickBox -->|kept| TaskList
    TickBox -->|unticked| Discard["Discarded"]
    Manual --> TaskList

    TaskList --> Pick
    Pick --> Place
    Place --> Plan
    Plan --> Owner
    Bad --> Owner

    %% ---------------- observability ----------------
    Search -.->|logs| PLog
    Grounded -.->|logs| PLog
    Ollama -.->|token usage| PLog
    Claude -.->|token usage| PLog

    %% ---------------- test coverage ----------------
    Fake --> Coverage
    Coverage -.->|verifies| Search
    Coverage -.->|verifies| Grounded
    Coverage -.->|verifies| Pick
    Mutation -.->|proves| Coverage

    %% ---------------- STYLING ----------------
    classDef human fill:#fde68a,stroke:#b45309,stroke-width:2px,color:#1c1917
    classDef ai fill:#ddd6fe,stroke:#6d28d9,stroke-width:2px,color:#1c1917
    classDef evaluator fill:#bbf7d0,stroke:#15803d,stroke-width:2px,color:#1c1917
    classDef tester fill:#bfdbfe,stroke:#1d4ed8,stroke-width:2px,color:#1c1917
    classDef bad fill:#fecaca,stroke:#b91c1c,stroke-width:2px,color:#1c1917
    classDef store fill:#e0f2fe,stroke:#0369a1,stroke-width:2px,color:#1c1917

    class Owner,Manual,TickBox human
    class Backend,Ollama,Claude,Draft ai
    class Grounded,Rules,Enough,Retry evaluator
    class Fake,Coverage,Mutation tester
    class Bad,Discard bad
    class KB,PLog,TaskList store
